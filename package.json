{
  "name": "@local/dsh-memories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "记忆库：在一页里配置华为 AgentArts、Hindsight、OpenViking 三个记忆后端的 Key 与服务地址，各自写进对应插件真正读取的位置。",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-rc.0 <0.3.0-0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "agentarts",
    "hindsight",
    "openviking"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElioFanyu/dsh-memories.git"
  },
  "bugs": {
    "url": "https://github.com/ElioFanyu/dsh-memories/issues"
  },
  "homepage": "https://github.com/ElioFanyu/dsh-memories#readme",
  "author": "ElioFanyu"
}
